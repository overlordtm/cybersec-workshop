
# Lab transit: host <-> LAB-GW (OPNsense WAN). See infra/README.md
auto vmbr1
iface vmbr1 inet static
	address 172.31.255.1/30
	bridge-ports none
	bridge-stp off
	bridge-fd 0
	ip-forward on
	post-up /etc/network/lab-nat.sh up
	post-up ip route replace 198.51.100.0/24 via 172.31.255.2
	post-up ip route replace 172.20.0.0/16 via 172.31.255.2
	post-up ip route replace 10.20.0.0/16 via 172.31.255.2
	post-down /etc/network/lab-nat.sh down
